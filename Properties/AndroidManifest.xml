<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- INTERNET: los canales se ven por internet; es la funcion entera de la aplicacion. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!--
    Android TV: ni pantalla tactil ni la biblioteca Leanback son obligatorias, asi que Play ofrece
    la aplicacion tanto a moviles como a televisores. El banner es lo que enseña el lanzador de TV.
  -->
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.software.leanback" android:required="false" />

  <application android:label="TDT Online"
               android:icon="@mipmap/ic_launcher"
               android:banner="@drawable/banner"
               android:allowBackup="true"
               android:supportsRtl="true"
               android:theme="@style/AppTheme"
               android:usesCleartextTraffic="true" />
</manifest>
