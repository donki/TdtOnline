<?xml version="1.0" encoding="utf-8"?>
<!--
  El codigo de la app se compila dentro del ensamblado de pruebas (ficheros enlazados), asi que hay
  que incluirlo en la cobertura y quitar las propias pruebas: cuenta solo lo que viene de la app.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <ExcludeByFile>**/TdtOnline.Tests/*.cs,**/TdtOnline.Tests/Fakes/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <Exclude>[*]AutoGeneratedProgram</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
