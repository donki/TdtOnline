<?xml version="1.0" encoding="utf-8"?>
<!-- Boton de contorno de marca; con el foco del mando se rellena, como el OutlineButton del movil. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focused" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/primary_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/primary_light" />
        </shape>
    </item>
</selector>
