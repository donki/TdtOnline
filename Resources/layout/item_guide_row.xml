<?xml version="1.0" encoding="utf-8"?>
<!-- Con la letra del sistema por encima del 100 %, GuideActivity.FitToFontScale agranda el alto
     (y el ancho de las tarjetas de programa) en la misma proporcion: con 92dp fijos y la letra al
     145 % el titulo del programa salia cortado por abajo (2026-09-29). En sp no vale: desde
     Android 14 la escala de letra no es lineal y un tamano grande apenas crece. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="6dp">

    <!-- El canal: con el foco y OK se abre. -->
    <LinearLayout
        android:id="@+id/channel"
        android:layout_width="150dp"
        android:layout_height="92dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/card_background"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/programs"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:clipToPadding="false" />
</LinearLayout>
