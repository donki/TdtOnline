<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows va en este marco y el relleno de 16dp en la columna de dentro: en la misma
     vista, Android cambia el relleno por el hueco de las barras del sistema y la pantalla se quedaba
     sin margen a los lados (el logo pegado al borde, 2026-09-29). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:contentDescription="@null" />

        <!-- Una sola linea: si no cabe, la letra encoge (hasta 14sp) y, si aun asi no, «…». -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeMaxTextSize="22sp"
            app:autoSizeStepGranularity="1sp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/chip_background"
            android:src="@drawable/ic_settings"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btn_guide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/chip_background"
            android:src="@drawable/ic_guide"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btn_about"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/chip_background"
            android:src="@drawable/ic_info"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Ultimo canal (se toca para volver a el) y recuento, cada uno en una linea. Antes iban en la
         misma fila que el titulo y los botones, y con la letra grande del sistema (145 %) no cabian:
         salia «TDT Onli / ne» y «Last watch / ed: …», partidos a mitad de palabra (2026-09-29). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/last_channel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/link_background"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/primary_light"
            android:visibility="invisible"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Buscador: filtra por nombre entre todos los canales, sea cual sea la categoria elegida. -->
    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/chip_background"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:inputType="text"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <!-- Categorias (ambitos de la lista): una fila de pastillas por la que se pasa con el mando. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false" />

    <!-- Como se llena Favoritos, cuando esta vacio. -->
    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- Canales de la categoria elegida. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false" />

</LinearLayout>
</FrameLayout>
